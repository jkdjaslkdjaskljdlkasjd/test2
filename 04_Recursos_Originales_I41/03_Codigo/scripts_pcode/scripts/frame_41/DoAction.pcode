SetMember
Push "KrinLang"
GetVariable
Push "ENGLISH"
GetMember
Push "BATTLESPEECH"
GetMember
Push 116, "Buen trabajo, Sonny. Sigue así y mantente alerta. Habrá más adelante."
SetMember
Push "KrinLang"
GetVariable
Push "ENGLISH"
GetMember
Push "BATTLESPEECH"
GetMember
Push 117, "¿Quiénes son ustedes? ¿Cómo encontraron este lugar?"
SetMember
Push "KrinLang"
GetVariable
Push "ENGLISH"
GetMember
Push "BATTLESPEECH"
GetMember
Push 118, "¿Dónde está el embajador?"
SetMember
Push "KrinLang"
GetVariable
Push "ENGLISH"
GetMember
Push "BATTLESPEECH"
GetMember
Push 119, "¿Embajador? No sé de qué hablas..."
SetMember
Push "KrinLang"
GetVariable
Push "ENGLISH"
GetMember
Push "BATTLESPEECH"
GetMember
Push 120, "¿Sabes algo de un arma secreta?"
SetMember
Push "KrinLang"
GetVariable
Push "ENGLISH"
GetMember
Push "BATTLESPEECH"
GetMember
Push 121, "Vinieron al lugar equivocado. Aquí no hay nada para ustedes."
SetMember
Push "KrinLang"
GetVariable
Push "ENGLISH"
GetMember
Push "BATTLESPEECH"
GetMember
