}
SetMember
locd21fb:Push "_root"
GetVariable
Push "__treeLinesVersion", 1
SetMember
Push "_root"
GetVariable
Push "__v14Desc", 0
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "626", "r", "Unleash the howl of your ancestors, dealing 240% of your Strength or 335% of your Instinct, whichever is higher, as Ice damage and stunning the target for 2 turns. Applies 3 Frostbite. This attack cannot be avoided.", "Unleash the howl of your ancestors, dealing 210% of your Strength or 295% of your Instinct, whichever is higher, as Ice damage and stunning the target for 2 turns. Applies 2 Frostbite. This attack cannot be avoided.", "Unleash the howl of your ancestors, dealing 180% of your Strength or 250% of your Instinct, whichever is higher, as Ice damage and stunning the target for 2 turns. This attack cannot be avoided.", 3
InitArray
Push "m", "If the target had at least 2 Scent of Blood, it loses 25 Focus at the start of its next 2 turns, and all other enemies receive 1 Frostbite and lose 15 Focus.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "628", "r", "Rend the enemy with frozen claws for 195% of your Strength or 275% of your Instinct, whichever is higher, as Ice damage, applying 2 Frostbite. The target receives 50% less healing for 2 turns.", "Rend the enemy with frozen claws for 170% of your Strength or 240% of your Instinct, whichever is higher, as Ice damage, applying 2 Frostbite. The target receives 40% less healing for 2 turns.", "Rend the enemy with frozen claws for 150% of your Strength or 210% of your Instinct, whichever is higher, as Ice damage, applying 1 Frostbite. The target receives 30% less healing for 2 turns.", 3
InitArray
Push "m", "Against Brittle targets, strikes a second time for 60% damage and applies 1 additional Frostbite.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "815", "r", "Bite the enemy with ancestral frost for 230% of your Strength or 320% of your Instinct, whichever is higher, as Ice damage. Applies 1 Frostbite, plus 1 for each Scent of Blood on the target, up to 3.", "Bite the enemy with ancestral frost for 205% of your Strength or 285% of your Instinct, whichever is higher, as Ice damage. Applies 1 Frostbite, plus 1 for each Scent of Blood on the target, up to 3.", "Bite the enemy with ancestral frost for 180% of your Strength or 250% of your Instinct, whichever is higher, as Ice damage. Applies 1 Frostbite, plus 1 for each Scent of Blood on the target, up to 3.", 3
InitArray
Push "m", "Against Brittle targets, damage is based on your Strength and Instinct combined. If this brings the target to 5 Frostbite, you recover 20 Focus.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "816", "r", "Shatter a target afflicted by at least 3 Frostbite, consuming them to deal 115% of your Strength or 160% of your Instinct, whichever is higher, as Ice damage per stack and dispel 2 buffs. This attack cannot be avoided.", "Shatter a target afflicted by at least 3 Frostbite, consuming them to deal 90% of your Strength or 125% of your Instinct, whichever is higher, as Ice damage per stack and dispel 1 buff. This attack cannot be avoided.", 2
InitArray
Push "m", "If 5 Frostbite were consumed, the target becomes Fragile, receiving 25% additional damage for 3 turns, and half of them spread to another enemy.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "818", "r", "Release a trail of frozen blood, dealing 140% of your Strength or 195% of your Instinct, whichever is higher, as Ice damage to all enemies. Applies 1 Frostbite and causes them to bleed for 25% of the same value each turn for 3 turns.", "Release a trail of frozen blood, dealing 110% of your Strength or 155% of your Instinct, whichever is higher, as Ice damage to all enemies. Applies 1 Frostbite and causes them to bleed for 20% of the same value each turn for 3 turns.", 2
InitArray
Push "m", "Enemies already afflicted by Frostbite receive 2 stacks instead.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "811", "r", "Passively allows you to track up to 3 Scent of Blood on each enemy. Your bleeding effects on frostbitten targets grant Scent each turn. Enemies with 3 Scent become Hunted, receiving 15% additional damage from your team and being unable to avoid your attacks.", "Passively allows you to track up to 2 Scent of Blood on each enemy. Your bleeding effects on frostbitten targets grant Scent each turn.", 2
InitArray
Push "m", "Hunted targets also receive 10% additional Ice damage.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "813", "r", "Go for the throat, dealing 140% of your Strength and reducing the target\'s Physical and Ice Defense by 30% for 3 turns. Destroys 30 Focus. Focus can be reduced to 0.", "Go for the throat, dealing 120% of your Strength and reducing the target\'s Physical and Ice Defense by 20% for 3 turns. Destroys 20 Focus. Focus can be reduced to 0.", 2
InitArray
Push "m", "Against Hunted targets, destroys twice as much Focus and prevents the use of abilities that require Focus for 1 turn.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "624", "r", "Rake the enemy for 205% of your Strength, causing it to bleed for 45% of your Strength each turn for 3 turns. Grants 1 Scent of Blood, or 2 if the target was already bleeding.", "Rake the enemy for 175% of your Strength, causing it to bleed for 35% of your Strength each turn for 3 turns. Grants 1 Scent of Blood, or 2 if the target was already bleeding.", "Rake the enemy for 150% of your Strength, causing it to bleed for 30% of your Strength each turn for 3 turns. Grants 1 Scent of Blood.", 3
InitArray
Push "m", "Against Hunted targets, the bleeding lasts 5 turns and cannot be dispelled.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "810", "r", "Pounce on the enemy for 150% of your Strength, dealing 30% extra damage for each Scent of Blood on the target. Recovers 10 Focus per Scent and grants Blood Rush, increasing your direct damage by 5% for 3 turns. Stacks up to 3 times.", "Pounce on the enemy for 130% of your Strength, dealing 25% extra damage for each Scent of Blood on the target. Recovers 8 Focus per Scent and grants Blood Rush, increasing your direct damage by 5% for 3 turns. Stacks up to 3 times.", 2
InitArray
Push "m", "At 3 Blood Rush, also causes bleeding for 30% of your Strength and grants 1 Scent of Blood.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "812", "r", "Cripple the enemy for 165% of your Strength, reducing its Speed by 40% for 2 turns. Grants 1 Scent of Blood, or 2 if the target is bleeding.", "Cripple the enemy for 140% of your Strength, reducing its Speed by 30% for 2 turns. Grants 1 Scent of Blood, or 2 if the target is bleeding.", 2
InitArray
Push "m", "Hunted targets slower than you also lose their next turn, once every 4 turns.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "627", "r", "Clamp down on the enemy with iron jaws for 190% of your Strength, destroying 30 Focus. Consumes 1 Scent of Blood, if present, to destroy an additional 25 Focus. Focus can be reduced to 0.", "Clamp down on the enemy with iron jaws for 160% of your Strength, destroying 20 Focus. Consumes 1 Scent of Blood, if present, to destroy an additional 20 Focus. Focus can be reduced to 0.", 2
InitArray
Push "m", "Consuming Scent also prevents the use of abilities that require Focus for 2 turns and restores up to 25 Focus to you.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "814", "r", "Passively increases the damage of your bleeding effects by 35%, and Rake\'s bleeding lasts 1 additional turn.", "Passively increases the damage of your bleeding effects by 20%.", 2
InitArray
Push "m", "Your bleeding effects can critically strike Hunted targets.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "817", "r", "Passively grants 10% Physical and Ice Piercing for each Scent of Blood on your target, up to 30%.", "Passively grants 7% Physical and Ice Piercing for each Scent of Blood on your target, up to 21%.", 2
InitArray
Push "m", "Critical strikes against Brittle targets grant 1 Scent of Blood.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "819", "r", "Execute the enemy for 280% of your Strength, consuming all Scent of Blood for an additional 80% per Scent. Deals 40% extra damage to targets below 35% Health and always critically strikes Brittle targets.", "Execute the enemy for 250% of your Strength, consuming all Scent of Blood for an additional 70% per Scent. Deals 40% extra damage to targets below 35% Health and always critically strikes Brittle targets.", "Execute the enemy for 220% of your Strength, consuming all Scent of Blood for an additional 60% per Scent. Deals 40% extra damage to targets below 35% Health and always critically strikes Brittle targets.", 3
InitArray
Push "m", "If the target dies, the Focus cost is refunded and your next attack deals 10% additional damage per Scent consumed, up to 30%.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "625", "r", "Awaken the instincts of an ally, increasing its Strength, Instinct and Speed by 25% for 3 turns.", "Awaken the instincts of an ally, increasing its Strength, Instinct and Speed by 18% for 3 turns.", 2
InitArray
Push "m", "All other allies also gain half of this bonus.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "821", "r", "Rally an ally with a thunderous call, healing it for 360% of your Strength or 505% of your Instinct, whichever is higher, increased by 10% for each Scent of Blood and Frostbite on all enemies, up to 80%. Removes 2 harmful effect(s), and its next direct attack deals 25% additional damage.", "Rally an ally with a thunderous call, healing it for 310% of your Strength or 435% of your Instinct, whichever is higher, increased by 10% for each Scent of Blood and Frostbite on all enemies, up to 80%. Removes 1 harmful effect(s), and its next direct attack deals 20% additional damage.", "Rally an ally with a thunderous call, healing it for 260% of your Strength or 365% of your Instinct, whichever is higher, increased by 10% for each Scent of Blood and Frostbite on all enemies, up to 80%. Removes 1 harmful effect(s), and its next direct attack deals 15% additional damage.", 3
InitArray
Push "m", "Allies below 30% Health are healed again for half the amount.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "808", "r", "Share the primal breath of the pack for 3 turns: all allies regenerate 8 Focus each turn, gain 15% Speed and take 15% less damage. Consumes 1 Scent of Blood from each marked enemy, increasing the Focus regeneration by 2 for each, up to 8.", "Share the primal breath of the pack for 3 turns: all allies regenerate 6 Focus each turn, gain 10% Speed and take 10% less damage. Consumes 1 Scent of Blood from each marked enemy, increasing the Focus regeneration by 2 for each, up to 8.", 2
InitArray
Push "m", "Allies are also immune to Speed reduction and Ice stuns during this effect.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "822", "r", "Stand guard over an ally, redirecting 40% of the direct damage it receives to you for 2 turns and shielding you for 220% of your Strength or 310% of your Instinct, whichever is higher. Consumes up to 2 Scent of Blood from the most marked enemy: each increases the shield by 35% and the duration by 1 turn.", "Stand guard over an ally, redirecting 30% of the direct damage it receives to you for 2 turns and shielding you for 170% of your Strength or 240% of your Instinct, whichever is higher. Consumes up to 2 Scent of Blood from the most marked enemy: each increases the shield by 35% and the duration by 1 turn.", 2
InitArray
Push "m", "When your shield breaks, you strike back at the attacker for 120% of your Strength.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "823", "r", "Passively increases your allies\' damage by 6% for each Scent of Blood on their target, up to 18%. Their attacks against Hunted targets heal them for 15% of the damage dealt.", "Passively increases your allies\' damage by 4% for each Scent of Blood on their target, up to 12%.", 2
InitArray
Push "m", "Whenever an ally strikes a Brittle target, your next ability costs 5 less Focus.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "820", "r", "Passively recovers 9 Focus for each Scent of Blood or Frostbite you consume, and 15 Focus whenever an enemy becomes Hunted or Frozen Solid.", "Passively recovers 6 Focus for each Scent of Blood or Frostbite you consume.", 2
InitArray
Push "m", "When an enemy becomes Hunted or Frozen Solid, the cooldown of all your abilities is reduced by 1 turn.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "824", "r", "Mark your prey and let the pack\'s howl echo, shielding all allies for 200% of your Strength or 280% of your Instinct, whichever is higher, for 2 turns. Consumes up to 2 Scent of Blood from the target: each grants a Pack Echo charge.", "Mark your prey and let the pack\'s howl echo, shielding all allies for 165% of your Strength or 230% of your Instinct, whichever is higher, for 2 turns. Consumes up to 2 Scent of Blood from the target: each grants a Pack Echo charge.", "Mark your prey and let the pack\'s howl echo, shielding all allies for 130% of your Strength or 180% of your Instinct, whichever is higher, for 2 turns. Consumes up to 2 Scent of Blood from the target: each grants a Pack Echo charge.", 3
InitArray
Push "m", "Each Scent consumed also applies 2 Frostbite to the target.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "825", "r", "Passively increases your Physical and Ice Defense by 28%.", "Passively increases your Physical and Ice Defense by 18%.", 2
InitArray
Push "m", "Frostbitten enemies deal 10% less damage to you.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "826", "r", "Catch your second wind, instantly healing 40% of your maximum Health and removing 1 harmful effect.", "Catch your second wind, instantly healing 30% of your maximum Health.", 2
InitArray
Push "m", "Consumes up to 3 Scent of Blood from your target, healing an additional 10% for each.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "809", "r", "Transform into an undead beast, increasing your Strength and Instinct by 35% and regenerating 12% of your maximum Health each turn for 3 turns.", "Transform into an undead beast, increasing your Strength and Instinct by 25% and regenerating 8% of your maximum Health each turn for 3 turns.", 2
InitArray
Push "m", "Each Scent of Blood you consume during this effect extends it by 1 turn, up to 2, and heals you for 5% of your maximum Health.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "827", "r", "Make a last stand, reducing damage taken by 70% and damage dealt by 20% for 1 turn. Consumes all Scent of Blood from the most marked enemy, reducing damage taken by an additional 5% for each, up to 85%.", "Make a last stand, reducing damage taken by 55% and damage dealt by 25% for 1 turn. Consumes all Scent of Blood from the most marked enemy, reducing damage taken by an additional 5% for each, up to 85%.", 2
InitArray
Push "m", "Enemies that strike you receive 2 Frostbite, and Brittle enemies become Frozen Solid.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "828", "r", "Passively reduces damage taken from damage-over-time effects by 30% and restores 5 Focus at the start of each of your turns. Consuming Scent of Blood removes 1 damage-over-time effect from you.", "Passively reduces damage taken from damage-over-time effects by 20%. Consuming Scent of Blood removes 1 damage-over-time effect from you.", 2
InitArray
Push "m", "Consuming 3 or more Scent in one action makes you immune to stuns for 1 turn.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "829", "r", "Passively shields you for 10% of your maximum Health for each Scent of Blood or Frostbite you consume, up to 40%, for 2 turns. Increases healing received by 15%.", "Passively shields you for 7% of your maximum Health for each Scent of Blood or Frostbite you consume, up to 35%, for 2 turns.", 2
InitArray
Push "m", "Freezing an enemy solid grants a shield equal to 15% of your maximum Health.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__v14Desc"
GetMember
Push "830", "r", "Once per combat, when you would die you survive with 25% of your maximum Health, gain a shield equal to 20% of your maximum Health and remove all harmful effects.", 1
InitArray
Push "m", "The enemy that struck the blow receives 3 Scent of Blood and 3 Frostbite.", 2
