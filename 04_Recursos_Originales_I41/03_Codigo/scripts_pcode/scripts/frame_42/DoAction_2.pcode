Not
If locd21fb
Push "_root"
GetVariable
Push "__linesPrevRefresh", "_root"
GetVariable
Push "__v9Refresh"
GetMember
SetMember
Push "_root"
GetVariable
Push "__v9Refresh"
DefineFunction2 "", 0, 2, false, true, true, false, true, false, true, false, false {
Push 0, register1, "__linesPrevRefresh"
