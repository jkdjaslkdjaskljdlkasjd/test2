SetMember
Push "_root"
GetVariable
Push "__trainingI0Version", 2
SetMember
Push "_root"
GetVariable
Push "__i1D", 0
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 624, "r", "Deals 235% of your Strength. The target bleeds for 45% of your Strength per turn for 3 turns. +1 Scent of Blood (+2 if it was already bleeding).", "Deals 200% of your Strength. The target bleeds for 35% of your Strength per turn for 3 turns. +1 Scent of Blood (+2 if it was already bleeding).", "Deals 170% of your Strength. The target bleeds for 30% of your Strength per turn for 3 turns. +1 Scent of Blood.", 3
InitArray
Push "m", "Against a Hunted target the bleed lasts 5 turns and cannot be dispelled.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 625, "r", "An ally gains 25% Strength, Instinct and Speed for 3 turns.", "An ally gains 18% Strength, Instinct and Speed for 3 turns.", 2
InitArray
Push "m", "Every other ally, you included, gains half the bonus: 12.5% for 3 turns.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 626, "r", "Deals 300% of your Strength as Ice damage (420% of your Instinct if higher). Stuns for 1 turn and applies 3 Frostbite. Cannot be avoided. Against 2+ Scents of Blood, consumes 2: the target loses 25 Focus at the start of each of its next 2 turns.", "Deals 260% of your Strength as Ice damage (364% of your Instinct if higher). Stuns for 1 turn and applies 2 Frostbite. Cannot be avoided. Against 2+ Scents of Blood, consumes 2: the target loses 20 Focus at the start of each of its next 2 turns.", "Deals 220% of your Strength as Ice damage (308% of your Instinct if higher). Stuns for 1 turn. Cannot be avoided. Against 2+ Scents of Blood, consumes 2: the target loses 15 Focus at the start of each of its next 2 turns.", 3
InitArray
Push "m", "Against 2+ Scents it also loses 25 more Focus per turn for 2 turns, and every other enemy gets 1 Frostbite and loses 15 Focus.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 627, "r", "Deals 280% of your Strength and destroys 20 Focus (40 against a Hunted target). For 2 turns the target takes 15% more damage and has 25% less Speed. If it has a Scent of Blood, consumes 1: destroys 10 more Focus and blocks its Focus abilities for 2 turns.", 1
InitArray
Push "m", "Consuming the Scent also returns up to 25 Focus to you.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 628, "r", "Deals 245% of your Strength as Ice damage (343% of your Instinct if higher). Applies 2 Frostbite (3 if the target is bleeding). For 5 turns the target has 10% less Ice Defense and receives 20% less healing.", "Deals 215% of your Strength as Ice damage (301% of your Instinct if higher). Applies 2 Frostbite (3 if the target is bleeding). For 5 turns the target has 10% less Ice Defense and receives 20% less healing.", "Deals 185% of your Strength as Ice damage (259% of your Instinct if higher). Applies 1 Frostbite (2 if the target is bleeding). For 5 turns the target has 10% less Ice Defense and receives 20% less healing.", 3
InitArray
Push "m", "Against a Brittle target you strike a second time for 60% of the damage and apply 1 more Frostbite.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 808, "r", "For 3 turns all allies recover 15 Focus per turn, gain 12% Speed and take 6% less damage.", "For 3 turns all allies recover 10 Focus per turn, gain 8% Speed and take 4% less damage.", 2
InitArray
Push "m", "While it lasts, your allies cannot be slowed or frozen.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 809, "r", "For 3 turns you gain 35% Strength and Instinct and recover 12% of your maximum Health per turn.", "For 3 turns you gain 25% Strength and Instinct and recover 8% of your maximum Health per turn.", 2
InitArray
Push "m", "Each Scent of Blood you consume while transformed extends it by 1 turn (up to 2) and heals you for 5% of your maximum Health.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 810, "r", "Deals 190% of your Strength, +30% per Scent of Blood on the target. Recovers 10 Focus per Scent. Grants Blood Rush: +5% direct damage for 3 turns, stacking up to 3 times.", "Deals 165% of your Strength, +30% per Scent of Blood on the target. Recovers 8 Focus per Scent. Grants Blood Rush: +5% direct damage for 3 turns, stacking up to 3 times.", 2
InitArray
Push "m", "At 3 Blood Rush stacks the target also bleeds for 30% of your Strength per turn for 2 turns, and you gain 1 Scent of Blood.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 811, "r", "Passive. Each enemy can carry up to 3 Scents of Blood. A Scent lasts 3 turns and each new one refreshes them. Your bleeds on a frostbitten target grant 1 Scent per turn. At 3 Scents the enemy is Hunted for 2 turns: it takes 15% more damage from your team and cannot avoid your attacks.", "Passive. Each enemy can carry up to 2 Scents of Blood. A Scent lasts 3 turns and each new one refreshes them. Your bleeds on a frostbitten target grant 1 Scent per turn.", 2
InitArray
Push "m", "Hunted enemies also take 10% more Ice damage.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 812, "r", "Deals 205% of your Strength and reduces the target\'s Speed by 40% for 2 turns. +1 Scent of Blood (+2 if the target is bleeding).", "Deals 175% of your Strength and reduces the target\'s Speed by 30% for 2 turns. +1 Scent of Blood (+2 if the target is bleeding).", 2
InitArray
Push "m", "A Hunted target slower than you also loses its next turn. Once every 4 turns.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 813, "r", "Deals 175% of your Strength, destroys 30 Focus and reduces the target\'s Physical and Ice Defense by 30% for 3 turns.", "Deals 150% of your Strength, destroys 20 Focus and reduces the target\'s Physical and Ice Defense by 20% for 3 turns.", 2
InitArray
Push "m", "Against a Hunted target it destroys twice the Focus and blocks its Focus abilities for 2 turns.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 814, "r", "Passive. Your bleeds deal 35% more damage, and Rake bleeds for 1 more turn.", "Passive. Your bleeds deal 20% more damage.", 2
InitArray
Push "m", "Your bleeds deal 50% more damage to Hunted targets.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 815, "r", "Deals 280% of your Strength as Ice damage (392% of your Instinct if higher). Applies 1 Frostbite, +1 per Scent of Blood on the target (max 3).", "Deals 250% of your Strength as Ice damage (350% of your Instinct if higher). Applies 1 Frostbite, +1 per Scent of Blood on the target (max 3).", "Deals 220% of your Strength as Ice damage (308% of your Instinct if higher). Applies 1 Frostbite, +1 per Scent of Blood on the target (max 3).", 3
InitArray
Push "m", "Against a Brittle target the damage adds your Strength and Instinct together. If it brings the target to 5 Frostbite, you recover 20 Focus.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 816, "r", "Deals 145% of your Strength as Ice damage (203% of your Instinct if higher) for each Frostbite on the target (1 hit if it has none). Cannot be avoided. At 3+ Frostbite it consumes them all and dispels 2 beneficial effects.", "Deals 115% of your Strength as Ice damage (161% of your Instinct if higher) for each Frostbite on the target (1 hit if it has none). Cannot be avoided. At 3+ Frostbite it consumes them all and dispels 1 beneficial effect.", 2
InitArray
Push "m", "If 5 Frostbite are consumed, the target becomes Fragile for 3 turns: it takes 25% more damage.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 817, "r", "Passive. You gain 10% Physical and Ice Piercing per Scent of Blood on your target (max 30%).", "Passive. You gain 7% Physical and Ice Piercing per Scent of Blood on your target (max 21%).", 2
InitArray
Push "m", "A critical hit on a Brittle target grants you 1 Scent of Blood.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 818, "r", "Deals 180% of your Strength as Ice damage (252% of your Instinct if higher) to all enemies and applies 1 Frostbite. For 3 turns they bleed for 10% of your Strength + 20% of your Instinct per turn and have 10% less Speed.", "Deals 160% of your Strength as Ice damage (224% of your Instinct if higher) to all enemies and applies 1 Frostbite. For 3 turns they bleed for 8% of your Strength + 16% of your Instinct per turn and have 10% less Speed.", "Deals 140% of your Strength as Ice damage (196% of your Instinct if higher) to all enemies and applies 1 Frostbite. For 3 turns they bleed for 6% of your Strength + 12% of your Instinct per turn and have 10% less Speed.", 3
InitArray
Push "m", "Enemies that already have Frostbite get 2 instead of 1.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 819, "r", "Deals 340% of your Strength, +80% per Scent of Blood on the target (consumes them all). +40% damage if the target is below 35% Health, +50% if it is Brittle; always a critical hit against a Brittle target.", "Deals 300% of your Strength, +80% per Scent of Blood on the target (consumes them all). +40% damage if the target is below 35% Health, +50% if it is Brittle.", "Deals 260% of your Strength, +80% per Scent of Blood on the target (consumes them all). +40% damage if the target is below 35% Health, +50% if it is Brittle.", 3
InitArray
Push "m", "If the target dies, the Focus is refunded and your next direct attack deals 10% more damage per Scent consumed (max 30%).", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 820, "r", "Passive. You recover 9 Focus per Scent of Blood or Frostbite you consume, and 15 Focus whenever an enemy becomes Hunted or is frozen solid.", "Passive. You recover 6 Focus per Scent of Blood or Frostbite you consume.", 2
InitArray
Push "m", "When an enemy becomes Hunted or is frozen solid, all your cooldowns drop by 1 turn.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 821, "r", "Heals an ally for 360% of your Strength (504% of your Instinct if higher) + 15% of its maximum Health, +10% per Scent of Blood and Frostbite in play (max +80%). Removes 2 harmful effects, and its next direct attack deals 25% more damage.", "Heals an ally for 310% of your Strength (434% of your Instinct if higher) + 12% of its maximum Health, +10% per Scent of Blood and Frostbite in play (max +80%). Removes 1 harmful effect, and its next direct attack deals 20% more damage.", "Heals an ally for 260% of your Strength (364% of your Instinct if higher) + 10% of its maximum Health, +10% per Scent of Blood and Frostbite in play (max +80%). Removes 1 harmful effect, and its next direct attack deals 15% more damage.", 3
InitArray
Push "m", "An ally below 30% Health is healed a second time for 50% of the amount.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 822, "r", "Guards an ally for 2 turns and shields you for 220% of your Strength (310% of your Instinct if higher). The shield absorbs 40% of the direct damage your ally takes; the guard ends when it breaks. Consumes up to 2 Scents of Blood from the most marked enemy: +35% shield and +1 turn each.", "Guards an ally for 2 turns and shields you for 170% of your Strength (240% of your Instinct if higher). The shield absorbs 30% of the direct damage your ally takes; the guard ends when it breaks. Consumes up to 2 Scents of Blood from the most marked enemy: +35% shield and +1 turn each.", 2
InitArray
Push "m", "When the shield breaks, you strike the attacker for 120% of your Strength.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 823, "r", "Passive. Your allies deal 6% more damage per Scent of Blood on their target (max 18%). Their hits on a Hunted target heal them for 15% of the damage dealt, and their critical hits extend the target\'s Scent by 1 turn.", "Passive. Your allies deal 4% more damage per Scent of Blood on their target (max 12%).", 2
InitArray
Push "m", "When an ally hits a Brittle target, you recover 5 Focus.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 824, "r", "Shields every ally for 200% of your Strength (280% of your Instinct if higher) for 2 turns and consumes up to 2 Scents of Blood from the target.", "Shields every ally for 165% of your Strength (231% of your Instinct if higher) for 2 turns and consumes up to 2 Scents of Blood from the target.", "Shields every ally for 130% of your Strength (182% of your Instinct if higher) for 2 turns and consumes up to 2 Scents of Blood from the target.", 3
InitArray
Push "m", "Each Scent consumed applies 2 Frostbite to the target.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 825, "r", "Passive. +28% Physical and Ice Defense, and you take 12% less damage.", "Passive. +18% Physical and Ice Defense, and you take 8% less damage.", 2
InitArray
Push "m", "While any enemy has Frostbite, you take 10% less damage.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 826, "r", "Heals you for 40% of your maximum Health and removes 1 harmful effect.", "Heals you for 30% of your maximum Health.", 2
InitArray
Push "m", "Consumes up to 3 Scents of Blood from the most marked enemy: +10% healing each.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 827, "r", "For 1 turn you take 70% less damage and deal 20% less. Consumes all Scents of Blood from the most marked enemy: -5% damage taken each (max 85%).", "For 1 turn you take 55% less damage and deal 25% less. Consumes all Scents of Blood from the most marked enemy: -5% damage taken each (max 85%).", 2
InitArray
Push "m", "Enemies that hit you meanwhile get 2 Frostbite; a Brittle attacker is frozen solid.", 2
InitObject
SetMember
Push "_root"
GetVariable
Push "__i1D"
GetMember
Push 828, "r", "Passive. You take 25% less damage from damage over time and recover 5 Focus at the start of each of your turns. Consuming a Scent of Blood removes 1 such effect from you.", "Passive. You take 15% less damage from damage over time. Consuming a Scent of Blood removes 1 such effect from you.", 2
InitArray
Push "m", "Consuming 3+ Scents in one action makes you immune to stuns for 1 turn.", 2
