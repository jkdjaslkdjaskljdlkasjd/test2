            {
               b_CheckYU = 1;
            }
            if(k_slotter.data.Class == 1)
            {
               p_CheckYU = 1;
            }
            if(k_slotter.data.Class == 2)
            {
               h_CheckYU = 1;
            }
         }
      }
      cfg++;
   }
   if(Krin.difficulty == 2)
   {
      if(Krin.questProgress[5] > 13)
      {
         if(Krin.Class == 0)
         {
            b_CheckYU = 1;
         }
         if(Krin.Class == 1)
         {
            p_CheckYU = 1;
         }
         if(Krin.Class == 2)
         {
            h_CheckYU = 1;
         }
      }
   }
   trace("Difficulty and Quest Progress and Class: " + Krin.difficulty + " " + Krin.questProgress[5] + " " + Krin.Class);
   trace("PROFILE " + (b_CheckYU + p_CheckYU + h_CheckYU));
   trace("Hydro " + h_CheckYU);
   trace("Bio " + b_CheckYU);
   trace("Psycho " + p_CheckYU);
   if(b_CheckYU + p_CheckYU + h_CheckYU == 3)
   {
      return true;
   }
   return false;
}
