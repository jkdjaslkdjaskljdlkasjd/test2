onClipEvent(load){
   function __f_initialize(eventObj)
   {
      icon = "";
      label = "Button";
      labelPlacement = "right";
      selected = false;
      toggle = false;
      enabled = true;
      visible = true;
      minHeight = 0;
      minWidth = 0;
   }
   this.addEventListener("initialize",__f_initialize);
}
